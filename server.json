{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.DareDev256/cutreview",
  "title": "Cut Review",
  "description": "Frame.io comments and client notes as Final Cut Pro to-do markers, then diff two FCPXML exports.",
  "websiteUrl": "https://daredev256.github.io/cutreview/",
  "icons": [
    {
      "src": "https://daredev256.github.io/cutreview/assets/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/DareDev256/cutreview",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "cutreview",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
